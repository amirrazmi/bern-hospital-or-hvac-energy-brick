bldg:Outside_Air_Temp a brick:Outside_Air_Temperature_Sensor ;
    rdfs:label "Outside Air Temp" ;
    h:timeseries "oat_c" .

bldg:Pharmacy_Cleanroom a brick:Medical_Room ;
    rdfs:label "Pharmacy Cleanroom" ;
    brick:hasPoint bldg:Pharmacy_Cleanroom_Humidity,
        bldg:Pharmacy_Cleanroom_Occupancy,
        bldg:Pharmacy_Cleanroom_Pressure_Diff,
        bldg:Pharmacy_Cleanroom_Temp ;
    h:roomType "pharmacy cleanroom GMP grade C" .

bldg:Pharmacy_Cleanroom_Humidity a brick:Zone_Air_Humidity_Sensor ;
    rdfs:label "Pharmacy Cleanroom Humidity" ;
    h:timeseries "pharmacy_cleanroom_rh" .

bldg:Pharmacy_Cleanroom_Occupancy a brick:Occupancy_Sensor ;
    rdfs:label "Pharmacy Cleanroom Occupancy" ;
    h:timeseries "pharmacy_cleanroom_occ" .

bldg:Pharmacy_Cleanroom_Pressure_Diff a brick:Air_Differential_Pressure_Sensor ;
    rdfs:label "Pharmacy Cleanroom Pressure Diff" ;
    h:timeseries "pharmacy_cleanroom_dp_pa" .

bldg:Pharmacy_Cleanroom_Temp a brick:Zone_Air_Temperature_Sensor ;
    rdfs:label "Pharmacy Cleanroom Temp" ;
    h:timeseries "pharmacy_cleanroom_t_c" .

bldg:Zone_OR_1 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_1" ;
    brick:hasPart bldg:OR_1 .

bldg:Zone_OR_2 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_2" ;
    brick:hasPart bldg:OR_2 .

bldg:Zone_OR_3 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_3" ;
    brick:hasPart bldg:OR_3 .

bldg:Zone_OR_4 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_4" ;
    brick:hasPart bldg:OR_4 .

bldg:Zone_OR_5 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_5" ;
    brick:hasPart bldg:OR_5 .

bldg:Zone_OR_6 a brick:HVAC_Zone ;
    rdfs:label "Zone OR_6" ;
    brick:hasPart bldg:OR_6 .

bldg:Zone_Pharmacy_Cleanroom a brick:HVAC_Zone ;
    rdfs:label "Zone Pharmacy_Cleanroom" ;
    brick:hasPart bldg:Pharmacy_Cleanroom .

